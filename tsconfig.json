{
    "compilerOptions": {
        "target": "ES2021",
        "module": "commonjs",
        "outDir": "./build/src/",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "./src",
        "./assets"
    ],
    "exclude": [
        "./node_modules/*",
        "./node_modules/@types/node/index.d.ts"
    ]
}
